## Custom functions ##########################################################
## Reload host keys from running lima instance (Claude)
function lima-reload --description 'Reload host keys from lima VM'
    ssh-keygen -R 192.168.105.2 2>/dev/null
    ssh-keyscan 192.168.105.2 2>/dev/null >> ~/.ssh/known_hosts
end

## Export keys for non-interactive shell sessions (Claude)
function claude-keys --description 'Load my SSH key into a persistent agent for Claude'
    set -l sock "$HOME/.ssh/agent.sock"

    # Key location: the host mount on the Lima guest, else the local key.
    set -l key "$HOME/.ssh/id_ed25519"
    test -e /mnt/hostfs/.ssh/id_ed25519; and set key /mnt/hostfs/.ssh/id_ed25519

    # Start a persistent agent at the fixed path if none is live there.
    env SSH_AUTH_SOCK="$sock" ssh-add -l >/dev/null 2>&1
    if test $status -eq 2
        rm -f "$sock"
        ssh-agent -a "$sock" >/dev/null
    end

    # Load the key (prompts for the passphrase once).
    env SSH_AUTH_SOCK="$sock" ssh-add "$key"
    and echo "Key loaded at $sock."
end

## Export terminfo to a device (Claude)
function export-terminfo -d "Export local terminfo to a remote device" --argument-names target
    infocmp | ssh $target "tic -x -"
end

## ssh-copy-id, but for root (Claude)
# `su -` and `~`: root's home is /home/root on these images, not /root.
function copy-id-root -d "ssh-copy-id, but for root" --argument-names target
    set -l key (ssh-add -L | head -n1)
    echo "== Enter the ROOT password for $target =="
    ssh -t $target "su - root -c 'mkdir -pm 700 ~/.ssh; grep -qxF \"$key\" ~/.ssh/authorized_keys 2>/dev/null || echo \"$key\" >> ~/.ssh/authorized_keys'"
end

## Prep a fresh dev device end to end (Claude)
# Reset its host key, trust it again, install my SSH key, and export terminfo
# for both the login user and root.
function dev-box --description 'Prep a dev device: reset host key, copy my key, export terminfo' --argument-names target
    if test -z "$target"
        echo "usage: dev-box <[user@]host>" >&2
        return 1
    end

    # `ssh-keygen -R` and `ssh-keyscan` ignore ~/.ssh/config, so resolve the
    # target with `ssh -G` first. This handles an ssh alias, user@ip, or a
    # bare ip, and matches how host keys are stored (under the real host).
    set -l host (ssh -G $target 2>/dev/null | string match -rg '^hostname (.+)$')
    if test -z "$host"
        echo "dev-box: cannot resolve a host for '$target'" >&2
        return 1
    end

    # 1. Drop any stale host key for this device.
    ssh-keygen -R $host 2>/dev/null

    # 2. Trust the device's current host key.
    ssh-keyscan $host 2>/dev/null >> ~/.ssh/known_hosts

    # 3. Install my SSH key as an authorized key on the device.
    ssh-copy-id $target

    # 4. Install my SSH key for root. Only step that needs the root password.
    copy-id-root $target

    # 5. Export my terminfo for the login user and for root.
    export-terminfo $target
    export-terminfo root@$host
end
